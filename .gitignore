# Global ignore for both client and server

# Node modules
/node_modules
/client/node_modules
/server/node_modules

# Testing and coverage
/coverage
/client/coverage
/server/coverage

# Build outputs
/build
/client/build
/server/build

# Environment files
.env.local
.env.development.local
.env.test.local
.env.production.local
/client/.env*
/server/.env*

# Misc
/.pnp
.pnp.js
.DS_Store

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
